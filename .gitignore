# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local logs
*.log
Requirement.mp4

# 3D source meshes — large, re-downloadable (see assets/ATTRIBUTION.md)
/assets/*.glb
/assets/*.stl
/assets/*.obj
/assets/preview/

# puppeteer profile from scripts/audit-case-studies.mjs
.chrome-profile/
shots/**/.chrome-profile/

# Raw Drive export — private third-party data (freelance_client_leads.xlsx),
# a non-shipping CV variant, defence-adjacent stills, and 119MB of unencoded
# video. Nothing here ships; scripts/build-media.mjs reads it and writes only
# to public/media/. See docs/DRIVE-AUDIT.md.
/docs/drive/

# Screen recordings and loose photos dropped at repo root for review — never ship
*.mp4
!public/media/*.mp4
!public/media/**/*.mp4
/image.png
/WhatsApp Image*
/*-*-*.*.*.mp4

# python bytecode caches from any invoked skill script
__pycache__/
*.pyc

# Playwright MCP verification snapshots — throwaway, from manual testing
.playwright-mcp/

# Claude Code's own project-local tooling (skills, settings) — installed
# tooling, not portfolio source. Was accidentally tracked (291 files, ~1.2GB)
# via an early `git add -A`; untracked below. Global skills live outside the
# repo (~/.claude) regardless — nothing here is needed to build or run the site.
.claude/

# scripts/shoot.mjs and friends write verification screenshots here — QA
# output, not source, never shipped. Was accidentally tracked (~14MB); untracked below.
/shots/

# my own ad-hoc verification screenshots dropped at repo root
lab-grid*.png
agent-header.png

# Hamza's own working notes / alternate specs (e.g. AUDIO-KIT.md) — his
# scratch space, not shipping content. Kept off git so a stray `git add -A`
# doesn't sweep it in.
/Claude outputs/

# GitHub spec-kit scaffold — AI-tooling infrastructure, not portfolio source.
/.specify/
